# Database connection string
DATABASE_URI=postgres://postgres:<password>@127.0.0.1:5432/theodenanyoh_web_dev
# Only read by docker-compose.yml. Use the same password as in DATABASE_URI.
POSTGRES_PASSWORD=<password>

# Used to encrypt JWT tokens
PAYLOAD_SECRET=YOUR_SECRET_HERE
NEXT_PUBLIC_SERVER_URL=http://localhost:3000
CRON_SECRET=YOUR_CRON_SECRET_HERE
PREVIEW_SECRET=YOUR_SECRET_HERE

# Email. Optional in development.
RESEND_API_KEY=enter-your-resend-api-key-here
DEFAULT_FROM_ADDRESS=enter-your-default-from-address-here
DEFAULT_FROM_NAME=enter-your-default-from-name-here

# Media storage. Leave S3_BUCKET unset in development to store uploads on local disk.
S3_ACCESS_KEY_ID=enter-your-s3-access-key-id-here
S3_SECRET_ACCESS_KEY=enter-your-s3-secret-access-key-here
S3_REGION=enter-your-s3-region-here
S3_BUCKET=enter-your-s3-bucket-name-here
S3_ENDPOINT=enter-your-s3-endpoint-here

# Cloudflare Turnstile. Use real keys only in Production.
# These published test keys always pass for local development and Preview.
NEXT_PUBLIC_TURNSTILE_SITE_KEY=1x00000000000000000000AA
TURNSTILE_SECRET_KEY=1x0000000000000000000000000000000AA
